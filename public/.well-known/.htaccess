# Allow access to assetlinks.json inside .well-known
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Allow from all
</IfModule>

<IfModule mod_headers.c>
    Header set Content-Type "application/json"
    Header set Access-Control-Allow-Origin "*"
</IfModule>
