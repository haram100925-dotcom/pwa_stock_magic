# Apache configuration for Dothome Hosting
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Ensure .well-known directory is accessible for Android AssetLinks verification
<IfModule mod_headers.c>
    <FilesMatch "^assetlinks\.json$">
        Header set Content-Type "application/json"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
